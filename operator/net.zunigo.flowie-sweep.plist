<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd agent for the FLOWIE sweep: every Sunday at 10:00 it runs scripts/flowie-sweep-notify.sh.
     Install:   cp operator/net.zunigo.flowie-sweep.plist ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/net.zunigo.flowie-sweep.plist
     Uninstall: launchctl bootout gui/$(id -u)/net.zunigo.flowie-sweep && rm ~/Library/LaunchAgents/net.zunigo.flowie-sweep.plist
     Paths are absolute because launchd does not expand ~; replace /Users/YOU/path/to/FLOWIE with this repo's location before installing. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.zunigo.flowie-sweep</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/YOU/path/to/FLOWIE/scripts/flowie-sweep-notify.sh</string>
  </array>

  <!-- Sunday 10:00 local time. If the Mac is asleep then, launchd runs it on wake. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- launchd starts with a bare PATH; the claude CLI lives in /opt/homebrew/bin. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- Only in the logged-in desktop session, where the login keychain and notifications are available. -->
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>

  <key>StandardOutPath</key>
  <string>/Users/YOU/path/to/FLOWIE/operator/reports/sweep-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/path/to/FLOWIE/operator/reports/sweep-launchd.log</string>
</dict>
</plist>
